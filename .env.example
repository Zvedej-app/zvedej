# Zkopíruj do souboru .env a doplň údaje ze Supabase (Project Settings → API).
# Bez těchto hodnot běží aplikace v demo režimu (data jen v zařízení).
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Volitelně: e-mail pro zpětnou vazbu (položka v Nastavení)
EXPO_PUBLIC_FEEDBACK_EMAIL=
